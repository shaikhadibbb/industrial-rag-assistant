# =============================================
# Industrial RAG Assistant — Environment Config
# Copy this file to .env and fill in your values
# =============================================

# --- App Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secret-api-key-here

# --- Ollama LLM ---
# Local: http://localhost:11434
# Render: set to your external Ollama endpoint (Groq, Modal, etc.)
OLLAMA_BASE_URL=http://localhost:11434

# --- Qdrant Vector Store ---
# Local dev: localhost / 6333 (no QDRANT_API_KEY needed)
# Qdrant Cloud: set host to your cluster endpoint (without https://)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Qdrant Cloud only — JWT token from cloud.qdrant.io dashboard
# Leave blank for local Qdrant
QDRANT_API_KEY=

# --- Observability ---
MLFLOW_TRACKING_URI=mlruns
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated allowed origins. Use * for open access (dev/demo only)
ALLOWED_ORIGINS=http://localhost:7860
